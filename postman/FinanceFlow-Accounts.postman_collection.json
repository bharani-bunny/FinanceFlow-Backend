{
  "info": {
    "name": "FinanceFlow Accounts",
    "description": "Run Login first, then the account requests. Set testEmail and testPassword to an existing FinanceFlow user. The Account ID is saved after Create.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "testEmail", "value": "" },
    { "key": "testPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "accountId", "value": "" }
  ],
  "item": [
    {
      "name": "Login (save access token)",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Login returns 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Login returns a JWT', function () { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });",
            "pm.collectionVariables.set('accessToken', pm.response.json().token);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "List my accounts",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200 and an account list', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/accounts" }
    },
    {
      "name": "Create account",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('Returns 201 with account fields', function () { pm.response.to.have.status(201); const body = pm.response.json(); pm.expect(body.id).to.exist; pm.expect(body.type).to.eql('CASH'); });",
        "pm.collectionVariables.set('accountId', pm.response.json().id);"
      ] } }],
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Cash Account\",\n  \"type\": \"CASH\",\n  \"balance\": 1500.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/accounts" }
    },
    {
      "name": "Get account by ID",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200 and the created account', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('accountId'))); });"] } }],
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
    },
    {
      "name": "Update account",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 200 with updated account', function () { pm.response.to.have.status(200); const body = pm.response.json(); pm.expect(body.name).to.eql('Postman Savings Account'); pm.expect(body.balance).to.eql(2000); });"] } }],
      "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Savings Account\",\n  \"type\": \"SAVINGS\",\n  \"balance\": 2000.00\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
    },
    {
      "name": "Delete account",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 204 No Content', function () { pm.response.to.have.status(204); });"] } }],
      "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/accounts/{{accountId}}" }
    },
    {
      "name": "Protected route rejects missing token",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Returns 401 without an access token', function () { pm.response.to.have.status(401); });"] } }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts" }
    }
  ]
}
